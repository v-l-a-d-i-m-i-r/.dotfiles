{
  "autoMemoryEnabled": false,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/dbus-notify-on-notification/dbus-notify-on-notification.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block-shell-edits/block-shell-edits.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/dbus-notify-on-stop/dbus-notify-on-stop.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "sonnet",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "ASD-STE100",
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(chmod +x *)",
      "Bash(git *)",
      "Bash(git:*)",
      "Bash(go build *)",
      "Bash(go get *)",
      "Bash(go mod *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(just *)",
      "Bash(just refs *)",
      "Bash(ls ~*)",
      "Bash(mkdir -p ~/.work-items/**)",
      "Bash(tmux show-*)",
      "Bash(tmux source-file *)",
      "Bash(zsh -cie \"nvm use $(cat .nvmrc) && ./setup-test-env.sh yarn *)",
      "Bash(zsh -cie \"nvm use $(cat .nvmrc) && npm *)",
      "Bash(zsh -cie \"nvm use $(cat .nvmrc) && npx *)",
      "Bash(zsh -cie \"nvm use $(cat .nvmrc) && yalc *)",
      "Bash(zsh -cie \"nvm use $(cat .nvmrc) && yarn *)",
      "Bash(zsh -cie \"nvm use \\$(cat .nvmrc) && ./setup-test-env.sh yarn *)",
      "Bash(zsh -cie \"nvm use \\$(cat .nvmrc) && npm *)",
      "Bash(zsh -cie \"nvm use \\$(cat .nvmrc) && npx *)",
      "Bash(zsh -cie \"nvm use \\$(cat .nvmrc) && yalc *)",
      "Bash(zsh -cie \"nvm use \\$(cat .nvmrc) && yarn *)",
      "Bash(zsh -cie \"nvm use \\\\$\\(cat .nvmrc\\) && ./setup-test-env.sh yarn *)",
      "Bash(zsh -cie \"nvm use \\\\$\\(cat .nvmrc\\) && npm *)",
      "Bash(zsh -cie \"nvm use \\\\$\\(cat .nvmrc\\) && npx *)",
      "Bash(zsh -cie \"nvm use \\\\$\\(cat .nvmrc\\) && yalc *)",
      "Bash(zsh -cie \"nvm use \\\\$\\(cat .nvmrc\\) && yarn *)",
      "Bash(~/.bin/work-item-id)",
      "Edit(/tmp/**)",
      "Edit(~/projects/**)",
      "Read(~/.work-items/**)",
      "Read(~/projects/**)",
      "Read(~/prompts/**)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "AskUserQuestion",
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(just install-*)",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendMessage"
    ]
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.bin/claude-status-line",
    "type": "command"
  },
  "theme": "auto"
}
